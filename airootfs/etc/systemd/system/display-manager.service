[Unit]
# Horizon wrapper display-manager unit. GDM was replaced by LightDM (issue #8):
# LightDM is repo-provided, X11-native, and needs none of GDM's GNOME-manager
# dependencies. The wrapper still routes boot through
# /usr/local/bin/horizon-display-manager so the horizon.diagnostic kernel
# cmdline path keeps bypassing the greeter entirely.
# NOTE: GDM's BusName=org.gnome.DisplayManager is gone on purpose - LightDM
# publishes no such D-Bus name.
Description=LightDM Display Manager

# replaces the getty
Conflicts=getty@tty1.service
After=getty@tty1.service

# replaces plymouth-quit since it quits plymouth on its own
Conflicts=plymouth-quit.service
After=plymouth-quit.service

# Needs all the dependencies of the services it's replacing
After=rc-local.service plymouth-start.service systemd-user-sessions.service

# LightDM stops plymouth as it starts; if it fails for any reason,
# make sure plymouth still stops
OnFailure=plymouth-quit.service

[Service]
ExecStart=/usr/local/bin/horizon-display-manager
KillMode=mixed
Restart=always
IgnoreSIGPIPE=no
EnvironmentFile=-/etc/locale.conf
ExecReload=/bin/kill -SIGHUP $MAINPID
KeyringMode=shared

[Install]
Alias=display-manager.service
