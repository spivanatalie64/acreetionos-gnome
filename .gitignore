# Build directories
work/
out/
../ISO/*.iso

# Compiled binaries
mkarchiso_wrapper
*.o

# Backup files
*.bak
*.save

# Pacman cache
/var/cache/pacman/pkg/*

# Compiled Python bytecode from running/checking first-party scripts.
# (Pre-built .pyc shipped inside the vendored airootfs/usr/lib/python3.11/
# stdlib tree are already tracked and unaffected by this rule.)
__pycache__/
*.pyc
