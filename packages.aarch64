################################################################################
# DISPLAY MANAGER & GNOME 48 DESKTOP
################################################################################
# NOTE: gdm was deliberately replaced by lightdm + lightdm-gtk-greeter here.
# GDM is unneeded baggage for an X11-only desktop and LightDM covers login +
# live-session autologin with repo packages only. Live autologin config is in
# airootfs/etc/lightdm/lightdm.conf.d/50-horizon-live.conf; system user lightdm
# in airootfs/etc/{passwd,group,shadow,gshadow} at uid/gid 120. See issue #8.
lightdm
lightdm-gtk-greeter
gnome-session
gnome-desktop
gnome-settings-daemon
mutter
gjs
libei
libdisplay-info
startup-notification
gnome-tweaks
gnome-shell
gnome-terminal
gnome-keyring
gnome-themes-extra

################################################################################
# DESKTOP INTEGRATION & PORTALS
################################################################################
xdg-desktop-portal-xapp
xdg-user-dirs
xdg-user-dirs-gtk
xdg-utils
accountsservice

