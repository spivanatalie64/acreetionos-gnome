################################################################################
# AcreetionOS Horizon - aarch64 (ARM) package list
# DERIVED from packages.x86_64 minus x86-only entries. Alpha tier:
# any package unavailable in Arch Linux ARM core/extra must be pruned after
# the first CI run reports it; patched XLibre packages are NOT built for arm,
# so this image uses the stock upstream stack (see pacman-aarch64.conf).
################################################################################
################################################################################
# AcreetionOS Package List v2.0 just using this see if our gitlab is working
# Optimized for minimal ISO size while maintaining full functionality
################################################################################
#  update line  
################################################################################
# CORE SYSTEM - Essential base system packages
################################################################################
base
linux
linux-headers
linux-atm
linux-firmware
linux-firmware-marvell
linux-firmware-qlogic
linux-firmware-whence
mkinitcpio
mkinitcpio-archiso
mkinitcpio-nfs-utils
mkinitcpio-busybox
mkinitcpio-systemd-tool
mkinitcpio-openswap
sudo
dbus
polkit
polkit-gnome
arch-install-scripts

################################################################################
# BOOT & BOOTLOADER - Required for booting the ISO and installing bootloader
################################################################################
grub
efibootmgr
os-prober
plymouth

################################################################################
